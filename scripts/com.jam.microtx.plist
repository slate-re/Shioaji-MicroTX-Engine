<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.jam.microtx</string>
  <key>ProgramArguments</key>
  <array>
    <string>/path/to/Shioaji-MicroTX-Engine/.venv/bin/microtx</string>
    <string>run</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict><key>MICROTX_CONFIRM_LIVE</key><string>YES</string></dict>
  <key>KeepAlive</key>
  <dict><key>SuccessfulExit</key><false/></dict>
  <key>RunAtLoad</key><true/>
  <key>StandardOutPath</key><string>/path/to/Shioaji-MicroTX-Engine/logs/stdout.log</string>
  <key>StandardErrorPath</key><string>/path/to/Shioaji-MicroTX-Engine/logs/stderr.log</string>
  <key>WorkingDirectory</key><string>/path/to/Shioaji-MicroTX-Engine</string>
</dict>
</plist>
