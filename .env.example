# ==========================================================
#  Shioaji-MicroTX-Engine 環境變數範本
#  使用方式：cp .env.example .env  然後填入自己的值
#  ⚠️ .env 已被 .gitignore 排除，絕不可提交至 Git
# ==========================================================

# ----------------------------------------------------------
#  1. 永豐 Shioaji API 憑證
#     申請：https://sinotrade.github.io/zh/tutor/prepare/token/
# ----------------------------------------------------------
SHIOAJI_API_KEY=your_api_key_here
SHIOAJI_SECRET_KEY=your_secret_key_here

# 憑證檔（僅「正式環境」下單需要；模擬模式留空即可）
# 路徑請放在專案外或 certs/ 目錄（已被 gitignore）
SHIOAJI_CA_PATH=
SHIOAJI_CA_PASSWORD=
SHIOAJI_PERSON_ID=

# ----------------------------------------------------------
#  2. 執行模式
#     SIMULATION=true  → 模擬環境（預設，安全，不需憑證）
#     SIMULATION=false → 正式環境（真實下單，需憑證 + 明確確認）
# ----------------------------------------------------------
SIMULATION=true

# 二次確認開關：即使 SIMULATION=false，未設為 true 也不會送出真實委託
# 這是防呆機制，避免誤觸實盤
ALLOW_LIVE_TRADING=false

# ----------------------------------------------------------
#  3. 交易標的
#     TMFR1 = 微型臺指（微台，每點 NT$10）
#     MXFR1 = 小型臺指（小台，每點 NT$50）
#     TXFR1 = 臺股期貨（大台，每點 NT$200）
# ----------------------------------------------------------
SYMBOL=TMFR1

# 期貨倉別：Auto（自動判斷新倉/平倉，預設最安全）或 DayTrade（當沖保證金）
# 改為 DayTrade 前請先在模擬環境確認帳戶具備當沖資格
FUTURES_OCTYPE=Auto

# ----------------------------------------------------------
#  4. 風險控管（全部為硬性上限，引擎啟動時載入）
# ----------------------------------------------------------
# 單筆下單口數
ORDER_QUANTITY=1
# 同時最大持有口數
MAX_POSITION_SIZE=2
# 單日最大虧損（新台幣，達到後強制停機並平倉）
MAX_DAILY_LOSS=3000
# 單日最大交易次數（防止程式失控連續下單）
MAX_DAILY_TRADES=10
# 兩次下單最短間隔（秒），節流防重複委託
ORDER_COOLDOWN_SEC=3

# ----------------------------------------------------------
#  5. 交易時段（台灣時間 HH:MM）
#     日盤 08:45–13:45；建議 13:40 強制平倉，留滑價餘裕
# ----------------------------------------------------------
SESSION_START=08:45
SESSION_END=13:45
FORCE_CLOSE_TIME=13:40
# 是否允許夜盤（15:00–05:00）
ENABLE_NIGHT_SESSION=false

# ----------------------------------------------------------
#  6. 🚨 緊急平倉（Kill Switch）
#
#     觸發方式（引擎常駐時，另開一個 terminal 或 SSH 進來執行）：
#       microtx panic     → 刪單 + 平倉 + 引擎停機（需人工重啟）
#       microtx flatten   → 刪單 + 平倉，引擎繼續待命
#
#     平倉部位以「向券商重新查詢」為準，不依賴引擎內部狀態，
#     因此即使引擎狀態機卡死，這個開關仍然有效。
# ----------------------------------------------------------
# 平倉最大重試次數（漲跌停鎖死時避免無窮迴圈）
EMERGENCY_MAX_RETRIES=5
# 每輪重試間隔（秒），期間會重新查詢部位確認是否平完
EMERGENCY_RETRY_INTERVAL_SEC=0.5
# 平倉用範圍市價（MKP）；設 false 則掛漲跌停價的限價單（成交順位相當，但有價格上限）
EMERGENCY_USE_MARKET_ORDER=true
# 取得共用鎖的等待上限（秒）。逾時代表有其他路徑卡住，
# 此時緊急平倉會改以「無鎖模式」強制繼續 —— 平不掉部位的風險遠大於併發送單
EMERGENCY_LOCK_TIMEOUT_SEC=2.0
# 收到 SIGTERM/SIGINT（例如 launchd 停止服務）時是否自動平倉
FLATTEN_ON_SHUTDOWN=true
# PID 檔路徑，CLI 靠它找到常駐行程送訊號
PID_FILE=runtime/microtx.pid
# 狀態快照檔。microtx status 與 healthcheck.sh 靠它的「新鮮度」
# 判斷引擎是「正常」「卡死」還是「無回應」—— PID 活著不代表引擎健康
STATUS_FILE=runtime/status.json
STATUS_WRITE_INTERVAL_SEC=5.0
# 當日累計損益與交易次數的持久化檔案。
# 沒有它的話，引擎重啟後單日停損上限會靜默歸零 —— 等於風控天花板被拆掉
DAILY_STATE_FILE=runtime/daily_state.json
# 交易日邊界（HH:MM）。夜盤 15:00 至次日 05:00 仍屬同一交易日，
# 因此邊界須落在夜盤結束與日盤開盤之間，不可用日曆日午夜
TRADING_DAY_BOUNDARY=06:00

# ----------------------------------------------------------
#  監看介面（microtx watch）
#  設為 false 時完全不啟動快照執行緒，對引擎零開銷
# ----------------------------------------------------------
ENABLE_QUOTE_SNAPSHOT=true
QUOTE_FILE=runtime/quote.json
# 報價快照寫入週期（秒）。實測單次寫入約 0.04ms，250ms 週期 CPU 佔用 0.015%
QUOTE_WRITE_INTERVAL_SEC=0.25

# ----------------------------------------------------------
#  7. 日誌
#     LOG_LEVEL: DEBUG / INFO / WARNING / ERROR
# ----------------------------------------------------------
LOG_LEVEL=INFO
LOG_DIR=logs
# 日誌保留天數
LOG_RETENTION_DAYS=30

# ----------------------------------------------------------
#  8. 通知（選用，留空則停用）
# ----------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
